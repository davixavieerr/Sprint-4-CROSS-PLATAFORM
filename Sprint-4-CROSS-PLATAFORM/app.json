{
  "expo": {
    "name": "ROÇA.AI Viário - Motiva",
    "slug": "roca-ai-ccr-motiva",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "A localização GPS é usada para georreferenciar ocorrências e inspeções nos trechos da SP-021 (CCR Motiva)."
        }
      ]
    ],
    "splash": {
      "image": "./assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B1F3A"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "android": {
      "package": "br.com.ccrmotiva.rocaai",
      "versionCode": 4,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1E3A8A"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "br.com.ccrmotiva.rocaai"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}